rules_version = '2';
// WVSU Journal for Law Advocacy: reader accounts.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // A reader's profile. Private unless they turn on "public".
    match /users/{uid} {
      allow read: if isMe(uid) || resource.data.public == true;
      allow create, update: if isMe(uid) && validProfile(request.resource.data);
      allow delete: if isMe(uid);

      // Reading progress, one document per article. Only the reader sees it.
      match /progress/{slug} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validProgress(request.resource.data);
      }

      // Highlights and private notes. Only the reader sees them.
      match /highlights/{id} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validHighlight(request.resource.data);
      }
    }

    function isEditor() { return signedIn() && exists(/databases/$(database)/documents/editors/$(request.auth.uid)); }

    // Bubble counts per article: { counts: { paragraphId: n } }. Public to read.
    // Signed-in readers may only change the counts map (the site adds 1 when posting).
    match /threads/{slug} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['counts'])
        && request.resource.data.counts is map
        && request.resource.data.counts.size() <= 2000;
      allow delete: if isEditor();
    }

    // Paragraph comments: live at once; hidden ones are visible to editors only.
    match /comments/{id} {
      allow read: if resource.data.hidden == false || isEditor();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['slug', 'pid', 'uid', 'name', 'thumb', 'text', 'parent', 'created', 'hidden', 'likedBy'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 120
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 8000
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && (request.resource.data.parent == null || (request.resource.data.parent is string && request.resource.data.parent.size() <= 40))
        && request.resource.data.created == request.time
        && request.resource.data.hidden == false
        && request.resource.data.likedBy == [];
      // anyone signed in may like or unlike (their own uid only); editors may hide or restore
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy.size() <= 5000
          && (request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()) == [request.auth.uid].toSet()
              || resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()) == [request.auth.uid].toSet()))
        || (isEditor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])));
      allow delete: if isEditor() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Reports on comments: anyone signed in can file one; only editors read or clear them.
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['commentId', 'slug', 'pid', 'uid', 'reason', 'created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.created == request.time;
      allow read, delete: if isEditor();
    }

    // Phones and browsers that opted in to notifications. Only the reader sees or changes their own.
    // (The Netlify functions read them with the admin key to send notifications.)
    match /pushDevices/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'token', 'topics', 'platform', 'updated'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && request.resource.data.topics is list && request.resource.data.topics.size() <= 4
        && request.resource.data.topics.hasOnly(['volumes', 'cfp', 'replies', 'streak']);
    }

    // Log of board announcements (written by the server only).
    match /announcements/{id} {
      allow read: if isEditor();
      allow write: if false;
    }

    // Editors (moderation, submissions). Added by hand in the console; never writable from the site.
    match /editors/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'bio', 'school', 'photo', 'thumb', 'public', 'joined', 'badges', 'weeks', 'stats', 'consent', 'prefs', 'follows'])
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 8000))
        && (!('prefs' in d) || (d.prefs is map && d.prefs.size() <= 20))
        && (!('follows' in d) || (d.follows is list && d.follows.size() <= 50))
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 280))
        && (!('school' in d) || (d.school is string && d.school.size() <= 80))
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 90000))
        && (!('public' in d) || d.public is bool)
        && (!('badges' in d) || (d.badges is list && d.badges.size() <= 200))
        && (!('weeks' in d) || (d.weeks is map && d.weeks.size() <= 600))
        && (!('stats' in d) || d.stats is map);
    }
    function validProgress(d) {
      return d.keys().hasOnly(['read', 'pct', 'done', 'doneAt', 'self', 'words', 'updated', 'at'])
        && d.read is list && d.read.size() <= 3000
        && d.pct is number && d.pct >= 0 && d.pct <= 100
        && d.done is bool;
    }
    function validHighlight(d) {
      return d.keys().hasOnly(['slug', 'pid', 'text', 'note', 'created'])
        && d.slug is string && d.slug.size() <= 120
        && d.pid is string && d.pid.size() <= 20
        && d.text is string && d.text.size() > 0 && d.text.size() <= 500
        && d.note is string && d.note.size() <= 1000;
    }
  }
}

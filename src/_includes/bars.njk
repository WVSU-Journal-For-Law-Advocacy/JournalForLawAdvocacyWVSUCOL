{#- Horizontal bar chart as an accessible table. Expects `rows` ([{label, n, sub?, url?}]), `max`, `caption`, `unit`. -#}
<table class="bars">
  <caption>{{ caption }}</caption>
  <thead><tr><th scope="col">{{ colLabel or "Category" }}</th><th scope="col">{{ unit | capitalize }}</th></tr></thead>
  <tbody>
    {%- for r in rows %}
    <tr title="{{ r.label }}: {{ r.n }} {{ unit if r.n != 1 else unitOne }}">
      <th scope="row">{% if r.url %}<a href="{{ r.url }}">{{ r.label }}</a>{% else %}{{ r.label }}{% endif %}{% if r.sub %}<small>{{ r.sub }}</small>{% endif %}</th>
      <td><span class="bar" style="--w:{{ (r.n / max * 100) | round(1) }}%"></span><span class="val">{{ r.n }}</span></td>
    </tr>
    {%- endfor %}
  </tbody>
</table>

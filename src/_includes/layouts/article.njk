---
layout: layouts/base.njk
---
{%- set d = { author: author, title: title, volume: volume, first_page: first_page, year: year, doi: doi } %}
{%- set vol = collections.issues | issueOf(volume, issue) %}
{%- set hasText = content | trim %}
{%- set slug = page.fileSlug %}
{%- set url = site.url + page.url %}
{%- if hasText %}
  {%- set parts = content | headingIds | splitFootnotes %}
  {%- set toc = parts.main | headings %}
  {%- set minutes = parts.main | readingTime %}
{%- endif %}
{%- set pages = (first_page + ("–" + last_page if last_page and last_page != first_page else "")) if first_page else "" %}

{#- The opening: area, title, authors, one quiet line. Everything else lives in the dock and the end matter. -#}
<header class="art-head"><div class="art-wrap">
  {#- the app shows the piece as a book first, like a reading app -#}
  {%- set cp = slug | coverFor(collections.coverPhotos) %}
  <div class="art-cover" aria-hidden="true"><span class="cover" style="--tone:{{ site.area_tones[area] or '#4A2466' }}">{% if cp %}<i class="cv-photo" style="background-image:url('{{ cp | coverSrc }}')"></i>{% endif %}<span class="cv-top">{{ area }}</span><span class="cv-title">{{ title.split(":")[0] }}</span><span class="cv-foot"><i></i>Vol. {{ volume | roman }} · {{ year }}</span></span></div>
  <p class="art-eyebrow"><a href="/areas/{{ area | slugify }}/" data-pagefind-filter="Area">{{ area }}</a><span hidden data-pagefind-filter="Type">{{ kind }}</span></p>
  <h1>{{ title }}</h1>
  <p class="art-authors">{% for au in author | authorLinks %}{% if not loop.first %}{{ " and " if loop.last else ", " }}{% endif %}{% if au.slug %}<a href="/authors/{{ au.slug }}/" data-pagefind-filter="Author">{{ au.name }}</a>{% else %}{{ au.name }}{% endif %}{% endfor %}</p>
  <p class="art-meta">
    {%- if vol %}<a href="{{ vol.url }}" data-pagefind-filter="Volume">Vol. {{ volume | roman }}</a>{% else %}<span data-pagefind-filter="Volume">Vol. {{ volume | roman }}</span>{% endif %}
    <span class="dot" aria-hidden="true">·</span><span>{{ year }}</span>
    {%- if minutes %}<span class="dot" aria-hidden="true">·</span><span>{{ minutes }} min</span>{% endif %}
  </p>
  {%- if cp %}<p class="art-photo">Cover photo: <a href="{{ cp.byUrl }}" rel="noopener">{{ cp.by }}</a> on <a href="https://unsplash.com/?utm_source=wvsu_journal_for_law_advocacy&amp;utm_medium=referral" rel="noopener">Unsplash</a></p>{% endif %}
  <p class="art-cta">{% if hasText %}<a class="btn" href="#fulltext">Start reading</a>{% elif pdf %}<a class="btn" href="{{ pdf }}">Read the PDF</a>{% endif %}<a class="btn alt" href="#share" data-sheet="share">Share</a></p>
  {%- if hasText and fulltext_status == "proofread-needed" %}
  <p class="art-note">Web text converted from the PDF · not yet proofread{% if pdf %} · <a href="{{ pdf }}">Read the PDF</a>{% endif %}</p>
  {%- elif not pdf %}
  <p class="art-note">The PDF of this article has not been uploaded yet.</p>
  {%- endif %}
</div></header>

<section class="art-body"><div class="art-wrap">
  <section class="abstract" aria-labelledby="abs-h">
    <h2 id="abs-h">Abstract</h2>
    <p>{{ abstract }}</p>
    {%- if takeaways and takeaways.length %}
    <details class="tk">
      <summary>Key takeaways <span>· {{ takeaways.length }}</span></summary>
      <ol class="tk-cards">
        {%- for t in takeaways %}
        <li><span class="tk-n">{{ loop.index }}<small>/{{ takeaways.length }}</small></span><p>{{ t }}</p></li>
        {%- endfor %}
      </ol>
    </details>
    {%- endif %}
  </section>

  {%- if hasText %}
  <div class="fulltext prose" id="fulltext">
    {{ parts.main | safe }}
  </div>
  {%- if parts.count %}
  <details class="fn-panel" id="footnotes" open>
    <summary>Footnotes <span>({{ parts.count }})</span></summary>
    {{ parts.notes | safe }}
  </details>
  {%- endif %}
  {%- else %}
  <div class="mark-read" data-mark-read>
    <p>This piece is online as a PDF.{% if pdf %} <a href="{{ pdf }}">Read it here</a>, then add it to your library.{% endif %}</p>
    <button class="btn sm alt" type="button" aria-pressed="false">Mark as read</button>
    <p class="mr-note off" hidden>Counted in your library as read. Badges count only articles read here on the page.</p>
  </div>
  {%- endif %}

  {#- End matter: one quiet block. The full Cite and Share panels open in the sheet. -#}
  <footer class="endmatter">
    <div class="em-row">
      <h2 class="em-lbl">Cite</h2>
      <p class="em-cite" id="em-cite">{{ d | cite(site.short) }}</p>
      <p class="em-acts"><button type="button" data-copy="#em-cite" data-copy-msg="Citation copied">Copy</button><a href="#cite" data-sheet="cite">More formats</a></p>
    </div>
    <div class="em-row">
      <h2 class="em-lbl">Share</h2>
      <p class="em-acts">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ url | urlencode }}" target="_blank" rel="noopener">Facebook</a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
        <button type="button" data-copy-link>Copy link</button>
        <button type="button" data-studio="classic" data-fmt="story" hidden>Make a Story</button>
        <a href="#share" data-sheet="share">More</a>
      </p>
    </div>
    {%- if keywords and keywords.length %}
    <p class="em-topics">{% for k in keywords %}<a href="/search/?q={{ k | urlencode }}">{{ k }}</a>{% endfor %}</p>
    {%- endif %}
    <p class="em-pub">Published in <a href="{{ vol.url if vol else '/archive/' }}">Volume {{ volume }}</a> of the {{ site.title }}, {{ year }}{% if pages %}, pp. {{ pages }}{% endif %}.{% if site.issn_print %} ISSN {{ site.issn_print }}.{% endif %}
      {%- if pdf %} <a href="{{ pdf }}">PDF</a>{% endif %}{% if vol and vol.data.pdf and pdf_page %} · <a href="{{ vol.data.pdf }}#page={{ pdf_page }}">Original volume</a>{% endif %}</p>
  </footer>

  {#- the full Cite and Share panels: shown in the sheet (and on the page only when scripts are off) -#}
  <div class="sheet-src">
  <section class="citebox" id="cite" aria-labelledby="cite-h"
    data-authors="{{ author | splitAuthors | dump }}" data-title="{{ title }}" data-journal="{{ site.title }}"
    data-abbrev="{{ site.short }}" data-volume="{{ volume }}" data-year="{{ year }}"
    data-first="{{ first_page }}" data-last="{{ last_page }}" data-doi="{{ doi }}"
    data-issn="{{ site.issn_online or site.issn_print }}" data-url="{{ url }}" data-key="{{ slug }}">
    <h2 id="cite-h">Cite this article</h2>
    <div class="filters cite-formats" role="group" aria-label="Citation format" hidden>
      <button type="button" data-fmt="house" aria-pressed="true">House style</button>
      <button type="button" data-fmt="bluebook" aria-pressed="false">Bluebook</button>
      <button type="button" data-fmt="apa" aria-pressed="false">APA 7</button>
      <button type="button" data-fmt="chicago" aria-pressed="false">Chicago</button>
    </div>
    <p class="cite" id="cite-text" aria-live="polite">{{ d | cite(site.short) }}</p>
    <div class="acts">
      <button class="btn sm" type="button" data-copy="#cite-text">Copy citation</button>
      <button class="btn sm alt" type="button" data-export="bib" hidden>BibTeX</button>
      <button class="btn sm alt" type="button" data-export="ris" hidden>RIS</button>
    </div>
    {%- if doi %}<p class="doi">DOI: <a href="https://doi.org/{{ doi }}">https://doi.org/{{ doi }}</a></p>{% endif %}
  </section>

  <section class="share-panel" id="share" aria-labelledby="share-h" data-url="{{ url }}" data-title="{{ title }}">
    <h2 id="share-h">Share this article</h2>
    <div class="share-links">
      <button class="btn sm" type="button" data-native-share hidden>Share…</button>
      <a class="btn sm alt" href="https://www.facebook.com/sharer/sharer.php?u={{ url | urlencode }}" target="_blank" rel="noopener">Facebook</a>
      <a class="btn sm alt" href="fb-messenger://share/?link={{ url | urlencode }}" data-touch-only hidden>Messenger</a>
      <a class="btn sm alt" href="https://x.com/intent/post?url={{ url | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a>
      <a class="btn sm alt" href="https://www.linkedin.com/sharing/share-offsite/?url={{ url | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
      <button class="btn sm alt" type="button" data-copy-link>Copy link</button>
    </div>
    <h3 class="ak-h">Share a passage</h3>
    <p class="off">Select any sentence in the article and tap <b>Share quote</b> for a framed quote card with its citation.</p>
    <p class="caption-box" id="reader-caption">Reading “{{ title }}” in the {{ site.title }}.
{{ url }}</p>
    <div class="acts"><button class="btn sm alt" type="button" data-copy="#reader-caption" data-copy-msg="Copied">Copy text and link</button></div>

    {#- authors who haven't verified their author page yet are invited to; the kit replaces this once they have -#}
    {%- set firstAuthor = (author | authorLinks) | first %}
    <p class="ak-nudge" data-author-nudge data-for="author-kit">Are you an author of this piece? {% if firstAuthor and firstAuthor.slug %}<a href="/authors/{{ firstAuthor.slug }}/#claim">Verify your author page</a>{% else %}Verify your author page{% endif %} to unlock your <b>author kit</b>: Instagram designs, ready-made images, and LinkedIn details.</p>

    {#- the authors' kit: shown only to this piece's verified authors (and to the Board) -#}
    {%- set authorSlugs = [] %}{% for au in author | authorLinks %}{% if au.slug %}{% set _ = authorSlugs.push(au.slug) %}{% endif %}{% endfor %}
    <section class="author-kit" id="author-kit" data-author-only="{{ authorSlugs | join(',') }}" hidden aria-labelledby="ak-title">
      <p class="ak-eyebrow"><span class="ak-for-author">For you as the author</span><span class="ak-for-board">Board view · the authors' kit</span></p>
      <h2 id="ak-title">Your author kit</h2>
      <p class="off">Only this piece's authors and the Board see this.</p>
      <h3 class="ak-h">Share it on Instagram</h3>
      <p class="off">Swipe through designs for a Story or a post, put the title over your own photo, or take a transparent sticker for your Story.</p>
      <div class="studio-open-btns">
        <button class="btn" type="button" data-studio="classic" data-fmt="story" hidden>Make a Story</button>
        <button class="btn alt" type="button" data-studio="classic" data-fmt="post" hidden>Make a post</button>
        <button class="btn alt" type="button" data-studio="photo" hidden>Use my photo</button>
      </div>
      <details class="kit-more">
      <summary>Ready-made images</summary>
      <div class="kit">
        <figure>
          <img src="/share/{{ slug }}-post.png" width="1080" height="1350" loading="lazy" alt="Share image: {{ title }}, published in Volume {{ volume }} of the {{ site.title }}">
          <figcaption>Post · 4:5</figcaption>
          <button class="btn sm" type="button" data-share-img="/share/{{ slug }}-post.png" hidden>Share image</button>
          <a class="btn sm alt" href="/share/{{ slug }}-post.png" download="{{ slug }}-post.png">Download</a>
        </figure>
        <figure>
          <img src="/share/{{ slug }}-story.png" width="1080" height="1920" loading="lazy" alt="Story image: {{ title }}, published in Volume {{ volume }} of the {{ site.title }}">
          <figcaption>Story · 9:16</figcaption>
          <button class="btn sm" type="button" data-share-img="/share/{{ slug }}-story.png" hidden>Share image</button>
          <a class="btn sm alt" href="/share/{{ slug }}-story.png" download="{{ slug }}-story.png">Download</a>
        </figure>
      </div>
      </details>
      <p class="caption-box" id="share-caption">Proud to share that my work, “{{ title }},” is published in Volume {{ volume }} of the {{ site.title }}, {{ site.institution }}.
Read it here: {{ url }}
#JournalForLawAdvocacy #WVSULaw</p>
      <div class="acts"><button class="btn sm alt" type="button" data-copy="#share-caption" data-copy-msg="Caption copied">Copy caption</button></div>

      {%- set certs = (author | certificates(slug)) if site.certificates else [] %}
      {%- if certs.length %}
      <h3 class="ak-h">Certificate of publication</h3>
      <p class="off">For each author: a certificate to print, frame, or share. Signature lines are left blank for the Executive Editor and Faculty Adviser.</p>
      <div class="certs">
        {%- for c in certs %}
        <figure class="cert">
          <img src="/certificates/{{ c.file }}.png" width="2339" height="1654" loading="lazy" alt="Certificate of publication for {{ c.name }}">
          <figcaption>{{ c.name }}</figcaption>
          <div class="acts">
            <a class="btn sm" href="/certificates/{{ c.file }}.pdf" download="Certificate - {{ c.name }}.pdf">Download PDF</a>
            <button class="btn sm alt" type="button" data-share-img="/certificates/{{ c.file }}.png" hidden>Share image</button>
          </div>
        </figure>
        {%- endfor %}
      </div>
      {%- endif %}

      <h3 class="ak-h">Add it to LinkedIn</h3>
      {%- set li = { volume: volume, year: year, first_page: first_page, slug: slug, url: url } %}
      {%- if site.certificates %}
      <p class="off">Show it under <em>Licenses &amp; certifications</em> with one click, or list it under <em>Publications</em> with the details below.</p>
      <div class="acts"><a class="btn sm" href="{{ li | linkedinCert(site) }}" target="_blank" rel="noopener">Add certificate to LinkedIn</a></div>
      {%- else %}
      <p class="off">List it under <em>Publications</em> on your profile with the details below.</p>
      {%- endif %}
      <dl class="li-fields">
        <div><dt>Title</dt><dd id="li-title">{{ title }}</dd><button class="chip" type="button" data-copy="#li-title" data-copy-msg="Title copied">Copy</button></div>
        <div><dt>Publisher</dt><dd id="li-pub">{{ site.title }} ({{ site.institution }})</dd><button class="chip" type="button" data-copy="#li-pub" data-copy-msg="Publisher copied">Copy</button></div>
        <div><dt>Publication date</dt><dd id="li-date">{{ year }}</dd><button class="chip" type="button" data-copy="#li-date" data-copy-msg="Date copied">Copy</button></div>
        <div><dt>Publication URL</dt><dd id="li-url">{{ url }}</dd><button class="chip" type="button" data-copy="#li-url" data-copy-msg="URL copied">Copy</button></div>
        <div><dt>Description</dt><dd id="li-desc">{{ abstract }}</dd><button class="chip" type="button" data-copy="#li-desc" data-copy-msg="Description copied">Copy</button></div>
      </dl>
      <p class="off">On your profile: <em>Add profile section → Recommended → Add publications</em>, then paste each field.</p>
      <div class="acts"><a class="btn sm alt" href="https://www.linkedin.com/in/me/" target="_blank" rel="noopener">Open my LinkedIn profile</a></div>
    </section>
  </section>
  </div>

  {%- set related = collections.articles | byArea(area) | exceptUrl(page.url) %}
  {%- if related.length %}
  <aside class="related" aria-label="Read next">
    <h2>Read next</h2>
    <div class="related-shelf">
      {%- for a in related.slice(0, 3) %}{% include "cover.njk" %}{% endfor %}
    </div>
    <p class="more"><a href="/areas/{{ area | slugify }}/">More on {{ area | lower }} →</a></p>
  </aside>
  {%- endif %}
</div></section>

{#- The reading dock: every tool in one place. A bottom bar on phones, a slim rail beside the text on desktop. -#}
<nav class="actionbar dock" aria-label="Reading tools">
  {%- if hasText %}
  <button type="button" class="dk dk-prog" data-dock="progress" aria-label="Reading progress">
    <span class="dk-ring"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="14"/><circle class="on" cx="18" cy="18" r="14"/></svg></span>
    <span class="dk-l dk-pct">{{ minutes }} min</span>
  </button>
  {%- if toc.length > 2 %}
  <button type="button" class="dk" data-dock="contents"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span class="dk-l">Contents</span></button>
  {%- endif %}
  <button type="button" class="dk" data-dock="display"><span class="dk-aa" aria-hidden="true">Aa</span><span class="dk-l">Display</span></button>
  <button type="button" class="dk" data-dock="listen" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span class="dk-l">Listen</span></button>
  <button type="button" class="dk" data-dock="discussion" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v10H9l-4 4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><b class="dk-n" hidden></b><span class="dk-l">Discuss</span></button>
  {%- else %}
  {%- if pdf %}<a class="dk" href="{{ pdf }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="dk-l">PDF</span></a>{% endif %}
  <a class="dk" href="#cite" data-sheet="cite"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h4v4c0 3-1.5 5-4 6M14 7h4v4c0 3-1.5 5-4 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="dk-l">Cite</span></a>
  {%- endif %}
  <a class="dk" href="#share" data-sheet="share"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3m0 0-4 4m4-4 4 4M5 12v7h14v-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="dk-l">Share</span></a>
  <button type="button" class="dk" data-dock="more"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.4" fill="currentColor"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/><circle cx="18" cy="12" r="1.4" fill="currentColor"/></svg><span class="dk-l">More</span></button>
  {#- while listening, the dock becomes the player -#}
  <div class="dk-player" role="group" aria-label="Listen" hidden>
    <button type="button" data-l="prev" aria-label="Previous paragraph">⏮</button>
    <button type="button" data-l="play" aria-label="Pause">❚❚</button>
    <button type="button" data-l="next" aria-label="Next paragraph">⏭</button>
    <button type="button" data-l="rate" aria-label="Speed">1×</button>
    <button type="button" data-l="close" aria-label="Stop listening">✕</button>
  </div>
</nav>

{#- contents and "more" menus, copied into the sheet when opened -#}
{%- if hasText and toc.length > 2 %}
<template id="tpl-contents"><ol class="sheet-toc">{% for h in toc %}<li class="lvl{{ h.level }}"><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ol></template>
{%- endif %}
<template id="tpl-more"><ul class="sheet-menu">
  <li><button type="button" data-save-offline data-title="{{ title }}"{% if pdf %} data-pdf="{{ pdf }}"{% endif %}>Save for offline</button></li>
  <li><a href="#cite" data-sheet="cite">Cite this article</a></li>
  {%- if pdf %}<li><a href="{{ pdf }}">Download the PDF</a></li>{% endif %}
  {%- if vol and vol.data.pdf and pdf_page %}<li><a href="{{ vol.data.pdf }}#page={{ pdf_page }}">Open in the original volume</a></li>{% endif %}
  {%- if hasText and parts.count %}<li><a href="#footnotes" data-open-footnotes>Footnotes ({{ parts.count }})</a></li>{% endif %}
  {%- if hasText %}<li><button type="button" data-focus-on>Focus mode</button></li>{% endif %}
  <li><a href="{{ vol.url if vol else '/archive/' }}">Volume {{ volume }} contents</a></li>
</ul></template>

{#- data for the share studio (drawn on the reader's device) -#}
{%- set shareData = {
  slug: slug, title: title, authors: author | splitAuthors, kind: kind, url: url,
  host: site.url | replace("https://", "") | replace("http://", ""),
  volume: volume, roman: volume | roman, year: year, ay: vol.data.academic_year if vol else "",
  pages: pages,
  pageCount: (last_page - first_page + 1) if (first_page and last_page) else 0,
  minutes: minutes or 0, notes: parts.count if hasText else 0
} %}
<script type="application/json" id="share-data">{{ shareData | jsonScript | safe }}</script>
<script src="/assets/js/share-studio.js" defer></script>
<script type="module" src="/assets/js/reader.js"></script>
<script type="module" src="/assets/js/reading-tools.js"></script>
<script type="module" src="/assets/js/comments.js"></script>

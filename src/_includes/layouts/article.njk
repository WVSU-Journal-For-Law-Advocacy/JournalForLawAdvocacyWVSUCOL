---
layout: layouts/base.njk
---
{%- set d = { author: author, title: title, volume: volume, first_page: first_page, year: year, doi: doi } %}
{%- set vol = collections.issues | issueOf(volume, issue) %}
{%- set hasText = content | trim %}
{%- if hasText %}
  {%- set parts = content | headingIds | splitFootnotes %}
  {%- set toc = parts.main | headings %}
{%- endif %}

<nav class="breadcrumb" aria-label="Breadcrumb"><div class="wrap art-wrap">
  <a href="/">Home</a><span aria-hidden="true">›</span><a href="/archive/">Archive</a><span aria-hidden="true">›</span>{% if vol %}<a href="{{ vol.url }}">Volume {{ volume }}</a>{% else %}Volume {{ volume }}{% endif %}
</div></nav>

<header class="art-head"><div class="wrap art-wrap">
  <div class="art-eyebrow">
    <p><a href="/areas/{{ area | slugify }}/" data-pagefind-filter="Area">{{ area }}</a><span class="star" aria-hidden="true">✦</span><span data-pagefind-filter="Type">{{ kind }}</span></p>
    <p class="art-cite" title="Official citation">{{ volume }} {{ site.short }}{% if first_page %} {{ first_page }}{% endif %}</p>
  </div>
  <h1>{{ title }}</h1>
  <p class="art-authors">{% for au in author | authorLinks %}{% if not loop.first %}{{ " and " if loop.last else ", " }}{% endif %}{% if au.slug %}<a href="/authors/{{ au.slug }}/" data-pagefind-filter="Author">{{ au.name }}</a>{% else %}{{ au.name }}{% endif %}{% endfor %}</p>
  <p class="art-meta">
    <span data-pagefind-filter="Volume">Volume {{ volume }}</span><span class="dot" aria-hidden="true">·</span>
    <span>{% if vol %}AY {{ vol.data.academic_year }}{% else %}{{ year }}{% endif %}</span>
    {%- if first_page %}<span class="dot" aria-hidden="true">·</span><span>pp. {{ first_page }}{% if last_page and last_page != first_page %}–{{ last_page }}{% endif %}</span>{% endif %}
    {%- if vol %}<span class="dot" aria-hidden="true">·</span><a href="{{ vol.url }}">See full volume →</a>{% endif %}
  </p>
  <div class="art-actions">
    {%- if pdf %}<a class="btn" href="{{ pdf }}"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Download PDF</a>{% endif %}
    {%- if vol and vol.data.pdf and pdf_page %}<a class="btn alt" href="{{ vol.data.pdf }}#page={{ pdf_page }}">View in the original volume</a>{% endif %}
    {%- if hasText and parts.count %}<a class="btn alt" href="#footnotes" data-open-footnotes>See footnotes</a>{% endif %}
  </div>
</div></header>

<section class="art-body"><div class="wrap art-wrap">
  {%- if not pdf %}<p class="off">The PDF of this article has not been uploaded yet.</p>{% endif %}

  <div class="abstract">
    <h2>Abstract</h2>
    <p>{{ abstract }}</p>
  </div>

  {%- if hasText %}
  <div class="fulltext prose" id="fulltext">
    {%- if fulltext_status == "proofread-needed" %}
    <p class="notice"><strong>Web version not yet proofread.</strong> This text was converted from the published PDF and may contain errors. Quote and cite from the <a href="{{ pdf }}">PDF</a>, which is the version of record.</p>
    {%- endif %}
    {%- if toc.length > 2 %}
    <nav class="article-toc" aria-label="Contents">
      <p>Contents</p>
      <ol>{% for h in toc %}<li class="lvl{{ h.level }}"><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ol>
    </nav>
    {%- endif %}
    {{ parts.main | safe }}
  </div>
  {%- if parts.count %}
  <details class="fn-panel" id="footnotes" open>
    <summary>Footnotes <span>({{ parts.count }})</span></summary>
    {{ parts.notes | safe }}
  </details>
  {%- endif %}
  {%- endif %}

  <div class="citebox" id="citebox"
    data-authors="{{ author | splitAuthors | dump }}" data-title="{{ title }}" data-journal="{{ site.title }}"
    data-abbrev="{{ site.short }}" data-volume="{{ volume }}" data-year="{{ year }}"
    data-first="{{ first_page }}" data-last="{{ last_page }}" data-doi="{{ doi }}"
    data-issn="{{ site.issn_online or site.issn_print }}" data-url="{{ site.url }}{{ page.url }}" data-key="{{ page.fileSlug }}">
    <h2>Cite this article</h2>
    <div class="filters cite-formats" role="group" aria-label="Citation format" hidden>
      <button type="button" data-fmt="house" aria-pressed="true">House style</button>
      <button type="button" data-fmt="bluebook" aria-pressed="false">Bluebook</button>
      <button type="button" data-fmt="apa" aria-pressed="false">APA 7</button>
      <button type="button" data-fmt="chicago" aria-pressed="false">Chicago</button>
    </div>
    <p class="cite" id="cite" aria-live="polite">{{ d | cite(site.short) }}</p>
    <div class="acts">
      <button class="btn sm" type="button" data-copy="#cite">Copy citation</button>
      <button class="btn sm alt" type="button" data-export="bib" hidden>Download BibTeX</button>
      <button class="btn sm alt" type="button" data-export="ris" hidden>Download RIS</button>
      <button class="btn sm alt" type="button" data-copy-link>Copy link</button>
    </div>
    {%- if doi %}<p class="doi">DOI: <a href="https://doi.org/{{ doi }}">https://doi.org/{{ doi }}</a></p>{% endif %}
  </div>

  <footer class="art-foot">
    {%- if keywords and keywords.length %}
    <p class="topics"><span>Topics</span>{% for k in keywords %}<a href="/search/?q={{ k | urlencode }}">{{ k }}</a>{% endfor %}</p>
    {%- endif %}
    <p class="published">Published in <a href="{{ vol.url if vol else '/archive/' }}">Volume {{ volume }}</a> of the {{ site.title }}, {{ year }}.{% if site.issn_print %} ISSN {{ site.issn_print }} (Print).{% endif %}</p>
  </footer>

  {%- set related = collections.articles | byArea(area) | exceptUrl(page.url) %}
  {%- if related.length %}
  <aside class="related" aria-label="More in {{ area }}">
    <h2>More in {{ area }}</h2>
    <ul>
      {%- for r in related.slice(0, 3) %}
      <li><a href="{{ r.url }}">{{ r.data.title }}</a><span>{{ r.data.author }} · Vol. {{ r.data.volume }} ({{ r.data.year }})</span></li>
      {%- endfor %}
    </ul>
    <p class="more"><a href="/areas/{{ area | slugify }}/">All {{ area | lower }} →</a></p>
  </aside>
  {%- endif %}
</div></section>

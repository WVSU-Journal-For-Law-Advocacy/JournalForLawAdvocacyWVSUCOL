<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.title) if title else (site.title + " | " + site.institution) %}
{%- set pageDesc = abstract or summary or description or site.description %}
{%- set ogImage = ("/og/" + page.fileSlug + ".png") if isArticle else "/og/site.png" %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title or site.title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#F7F3EA" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#120B19" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="light dark">
<script>document.documentElement.classList.add("js");try{document.documentElement.dataset.theme=localStorage.getItem("jla-theme")||"light"}catch(e){document.documentElement.dataset.theme="light"}</script>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/app/apple-touch-icon-180.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="WVSU JLA">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Cormorant+SC:wght@500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
{%- if isArticle %}
{# Google Scholar indexing tags #}
<meta name="citation_title" content="{{ title }}">
{%- for au in author | splitAuthors %}<meta name="citation_author" content="{{ au }}">{% endfor %}
<meta name="citation_journal_title" content="{{ site.title }}">
<meta name="citation_journal_abbrev" content="{{ site.short }}">
<meta name="citation_publisher" content="{{ site.institution }}">
<meta name="citation_publication_date" content="{{ year }}">
<meta name="citation_volume" content="{{ volume }}">
{%- if first_page %}<meta name="citation_firstpage" content="{{ first_page }}">{% endif %}
{%- if last_page %}<meta name="citation_lastpage" content="{{ last_page }}">{% endif %}
{%- if doi %}<meta name="citation_doi" content="{{ doi }}">{% endif %}
{%- if site.issn_online or site.issn_print %}<meta name="citation_issn" content="{{ site.issn_online or site.issn_print }}">{% endif %}
{%- for k in keywords %}<meta name="citation_keywords" content="{{ k }}">{% endfor %}
{%- if pdf %}<meta name="citation_pdf_url" content="{{ site.url }}{{ pdf }}">{% endif %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": title,
  "author": author | splitAuthors | personList,
  "abstract": abstract,
  "keywords": (keywords or []) | join(", "),
  "datePublished": year | string,
  "url": site.url + page.url,
  "sameAs": ("https://doi.org/" + doi) if doi else undefined,
  "isPartOf": { "@type": "PublicationVolume", "volumeNumber": volume | string,
    "isPartOf": { "@type": "Periodical", "name": site.title, "issn": (site.issn_online or site.issn_print) or undefined } }
} | jsonScript | safe }}</script>
{%- else %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Periodical",
  "name": site.title,
  "url": site.url,
  "inLanguage": "en",
  "issn": (site.issn_online or site.issn_print) or undefined,
  "publisher": { "@type": "CollegeOrUniversity", "name": site.institution, "address": site.city }
} | jsonScript | safe }}</script>
{%- endif %}
{%- if site.goatcounter %}
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{%- endif %}
</head>
<body{% if isArticle %} class="has-actionbar"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<div id="bar" aria-hidden="true"></div>
{%- set volumeLinks = [["/archive/", "Every volume"]] %}
{%- for i in collections.issues %}{% set _ = volumeLinks.push([i.url, i.data.title + " · AY " + i.data.academic_year]) %}{% endfor %}
{%- set nav = [
  { url: "/articles/", label: "Articles", sub: [["/articles/", "All articles"], ["/search/", "Search the journal"]] },
  { url: "/archive/", label: "Archive", sub: volumeLinks },
  { url: "/authors/", label: "Authors" },
  { url: "/news/", label: "News" },
  { url: "/about/", label: "About", sub: [["/about/", "About the journal"], ["/about/history/", "History"], ["/board/", "Editorial board"], ["/about/numbers/", "By the numbers"], ["/policies/", "Policies"]] },
  { url: "/submit/", label: "Submit", sub: [["/submit/", "Submission guidelines"], ["/call-for-papers/", "Call for papers"], ["/policies/peer-review/", "How we review"], ["/policies/how-to-cite/", "How to cite"]] }
] %}
{%- if site.announcement %}
<div class="ribbon" id="ribbon" data-key="{{ site.announcement | slugify }}">
  <span>{{ site.announcement }}{% if site.deadline %} Deadline: {{ site.deadline }}.{% endif %} {% if cfp.active %}<a href="/call-for-papers/">See the {{ cfp.kind | lower }} →</a>{% else %}<a href="/submit/">How to submit →</a>{% endif %}</span>
  <button class="x" type="button" aria-label="Dismiss announcement"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
</div>
{%- endif %}

<header class="site-head" id="sitehead">
  <div class="head-in">
    <div class="head-left">
      <button class="icon-btn menu-btn" id="menu" type="button" aria-expanded="false" aria-controls="menusheet" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <a class="brand" href="/" aria-label="{{ site.title }}, home">
      <img src="/assets/img/seal-240.png" alt="" width="40" height="40">
      <span class="wordmark"><span class="full"><span class="pre">WVSU</span> Journal for Law Advocacy</span><span class="short">WVSU JLA</span></span>
    </a>
    <div class="head-right">
      <button class="icon-btn tb tb-desk" type="button" aria-label="Switch to dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <a class="icon-btn search-desk" href="/search/" aria-label="Search"{% if page.url == "/search/" %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </a>
      <a class="icon-btn acct-btn" href="/account/" aria-label="My library"{% if page.url == "/account/" %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.5 20c1.2-3.7 4-5.6 7.5-5.6s6.3 1.9 7.5 5.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </a>
    </div>
  </div>
  <nav class="primary" aria-label="Main">
    <ul>
      {%- for l in nav %}
      <li{% if l.sub %} class="has-sub"{% endif %}><a href="{{ l.url }}"{% if l | navActive(page.url) %} aria-current="page"{% endif %}>{{ l.label }}{% if l.sub %}<svg class="caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>{% endif %}</a>
        {%- if l.sub %}
        <ul class="drop">
          {%- for s in l.sub %}
          <li><a href="{{ s[0] }}"{% if page.url == s[0] %} aria-current="page"{% endif %}>{{ s[1] }}</a></li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </nav>
</header>

<div class="menu-sheet" id="menusheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="sheet-top">
    <button class="icon-btn" type="button" data-close-menu aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
    <button class="icon-btn tb" type="button" aria-label="Switch to dark mode">
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
  <form class="msearch" action="/search/" role="search">
    <label for="m-q" class="sr">Search the journal</label>
    <input id="m-q" name="q" type="search" placeholder="Search the journal">
    <button class="btn sm" type="submit">Search</button>
  </form>
  <nav aria-label="Menu">
    <ul>
      <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
      <li><a href="/account/"{% if page.url == "/account/" %} aria-current="page"{% endif %}>My library</a></li>
      {%- for l in nav %}
      <li><a href="{{ l.url }}"{% if l | navActive(page.url) %} aria-current="page"{% endif %}>{{ l.label }}</a>
        {%- if l.sub %}
        <ul class="msub">
          {%- for s in l.sub %}{% if s[0] != l.url %}
          <li><a href="{{ s[0] }}"{% if page.url == s[0] %} aria-current="page"{% endif %}>{{ s[1] }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </nav>
  <div class="mfoot">
    <img src="/assets/img/seal-240.png" alt="" width="56" height="56" loading="lazy">
    <p>{{ site.institution }}<br>Est. MMXXI{% if site.issn_print %} · ISSN {{ site.issn_print }}{% endif %}</p>
  </div>
</div>

<main id="main"{% if not searchExclude %} data-pagefind-body{% endif %}>
{{ content | safe }}
</main>

<footer class="site-foot" id="contact"><div class="wrap">
  <div class="foot-mast">
    <img src="/assets/img/seal-240.png" alt="Seal of the WVSU Journal for Law Advocacy" width="72" height="72" loading="lazy">
    <h2>{{ site.title }}</h2>
    <p class="est">Est. MMXXI · {{ site.city }}</p>
    <p>{{ site.institution }}</p>
    <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    {%- if site.issn_print %}<p class="issn">ISSN {{ site.issn_print }} (Print){% if site.issn_online %} · ISSN {{ site.issn_online }} (Online){% endif %}</p>{% endif %}
  </div>

  <div class="foot-cols">
    <details open><summary>The Journal</summary><ul>
      <li><a href="/articles/">Articles</a></li><li><a href="/archive/">Archive</a></li><li><a href="/authors/">Authors</a></li><li><a href="/news/">News</a></li><li><a href="/search/">Search</a></li>
    </ul></details>
    <details open><summary>About</summary><ul>
      <li><a href="/about/">About the journal</a></li><li><a href="/about/history/">History</a></li><li><a href="/board/">Editorial board</a></li><li><a href="/about/numbers/">By the numbers</a></li><li><a href="/call-for-papers/">Call for papers</a></li><li><a href="/submit/">Submit</a></li>
    </ul></details>
    <details open><summary>Policies</summary><ul>
      {%- for p in collections.policies %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
      <li><a href="/privacy/">Privacy notice</a></li><li><a href="/community/">Community guidelines</a></li>
    </ul></details>
  </div>

  <div class="foot-news">
    <h2>Stay informed</h2>
    <p>One email when a new volume is published.</p>
    <form class="subscribe" name="newsletter" method="POST" action="/subscribed/" data-netlify="true" netlify-honeypot="website">
      <input type="hidden" name="form-name" value="newsletter">
      <p class="hp"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off"></label></p>
      <label for="nl-email" class="sr">Email address</label>
      <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com">
      <button class="btn sm" type="submit">Subscribe</button>
    </form>
    {%- if site.facebook or site.instagram %}
    <ul class="social">
      {%- if site.facebook %}<li><a href="{{ site.facebook }}" rel="noopener">Facebook</a></li>{% endif %}
      {%- if site.instagram %}<li><a href="{{ site.instagram }}" rel="noopener">Instagram</a></li>{% endif %}
    </ul>
    {%- endif %}
    <button class="tb tb-foot" type="button" aria-label="Switch to dark mode"><span class="i-moon">Dark mode</span><span class="i-sun">Light mode</span></button>
  </div>
  <small class="note">© {% year %} {{ site.title }}, {{ site.institution }}. Articles are open access under <a href="/policies/open-access/">CC BY-NC 4.0</a> unless stated otherwise. Views expressed are those of the authors.</small>
</div></footer>
<div id="toast" role="status" aria-live="polite"></div>
{%- if site.firebase and site.firebase.apiKey %}
<script type="application/json" id="fb-config">{{ site.firebase | jsonScript | safe }}</script>
{%- endif %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
---
layout: layouts/base.njk
---
{%- set contents = collections.articles | inIssue(volume, issue) %}
<header class="pagehead"><div class="wrap">
  <p class="crumb"><a href="/archive/">Archive</a></p>
  <h1>{{ title }}{% if theme %}: {{ theme }}{% endif %}</h1>
  <p>Academic Year {{ academic_year }}{% if status == "forthcoming" %} · Forthcoming{% elif status == "current" %} · Current volume{% endif %}</p>
</div></header>

<section><div class="wrap">
  {%- if pdf %}<p class="btns" style="margin:0 0 2rem"><a class="btn" href="{{ pdf }}">Read the full volume (PDF)</a></p>{% endif %}
  {%- if contents.length %}
  <div class="toc" style="max-width:46rem">
    <h2>Contents</h2>
    <p class="meta">{{ contents.length }} {{ "item" if contents.length == 1 else "items" }}</p>
    <ol>
      {%- for a in contents %}
      <li style="--n:{{ loop.index0 }}"><a href="{{ a.url }}"><span class="tt">{{ a.data.title }}<small>{{ a.data.author }} · {{ a.data.kind }}</small></span><span class="dots"></span><span class="pg">{{ a.data.first_page }}</span></a></li>
      {%- endfor %}
    </ol>
  </div>
  {%- else %}
  <p class="sub">The contents of this volume will be posted when it is published.</p>
  {%- endif %}
</div></section>

{%- if contents.length %}
{%- set nContents = ((contents.length + 4) / 5) | int %}
{%- set nSlides = 2 + (nContents if nContents < 17 else 17) %}
<section class="wash launch" id="launch-kit" data-volume="{{ volume }}"><div class="wrap">
  <h2 class="title">Launch kit</h2>
  <p class="sub">A ready-made carousel for Instagram and Facebook: {{ nSlides }} slides announcing {{ title }}.</p>
  <div class="slides" role="list">
    {%- for k in range(1, nSlides + 1) %}
    {%- set f = "/share/volume-" + volume + "/slide-" + ("0" + k if k < 10 else k) + ".png" %}
    <figure class="slide" role="listitem">
      <img src="{{ f }}" width="1080" height="1350" loading="lazy" alt="{{ title }}, launch slide {{ k }} of {{ nSlides }}">
      <a class="chip" href="{{ f }}" download="jla-volume-{{ volume }}-slide-{{ k }}.png">Slide {{ k }} ↓</a>
    </figure>
    {%- endfor %}
  </div>
  <div class="btns">
    <button class="btn" type="button" data-share-slides="{{ nSlides }}" hidden>Share all slides</button>
    <button class="btn alt" type="button" data-copy="#launch-caption" data-copy-msg="Caption copied">Copy caption</button>
  </div>
  <p class="caption-box" id="launch-caption" style="max-width:36rem;margin-inline:auto">{{ title }} of the {{ site.title }} is now online. {{ contents.length }} pieces of scholarship from the {{ site.institution }}, free to read, download, and cite.
{{ site.url }}{{ page.url }}
#JournalForLawAdvocacy #WVSULaw</p>
</div></section>
{%- endif %}

<section><div class="wrap">
  <form class="form subscribe-box" name="newsletter" method="POST" action="/subscribed/" data-netlify="true" netlify-honeypot="website">
    <input type="hidden" name="form-name" value="newsletter">
    <p class="hp"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off"></label></p>
    <h2>Get the next volume by email</h2>
    <p>One email when a new volume is published. Nothing else.</p>
    <div class="field"><label for="vol-email">Email address</label><input id="vol-email" name="email" type="email" required autocomplete="email"></div>
    <button class="btn" type="submit">Subscribe</button>
  </form>
</div></section>

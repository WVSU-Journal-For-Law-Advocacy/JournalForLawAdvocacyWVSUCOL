---
layout: layouts/base.njk
pagination:
  data: collections.authors
  size: 1
  alias: person
permalink: "/authors/{{ person.slug }}/"
eleventyComputed:
  title: "{{ person.name }}"
  description: "{{ person.name }}: publications in the WVSU Journal for Law Advocacy, WVSU College of Law."
searchExclude: true
---
{%- set prof = person | profileFor(authorProfiles, board) %}
{%- set first = person.articles | last %}
{%- set service = (collections.editors | where("slug", person.slug)) | first %}
{%- set vols = [] %}{% for a in person.articles %}{% set vr = a.data.volume | roman %}{% if not (vr in vols) %}{% set _ = vols.push(vr) %}{% endif %}{% endfor %}
{#- A scholar's profile: who they are, then their work set like a bibliography. Verified details arrive from author-page.js. -#}
<header class="author-head"><div class="wrap" id="author-head" data-slug="{{ person.slug }}" data-name="{{ person.name }}">
  <p class="crumb"><a href="/authors/">Authors</a></p>
  <div class="ah-id">
    {%- if prof.photo %}
    <img class="portrait" src="{{ prof.photo }}" alt="Portrait of {{ person.name }}" width="112" height="112">
    {%- else %}
    <div class="portrait monogram" aria-hidden="true">{{ person.name | monogram }}</div>
    {%- endif %}
    <div class="ah-name">
      <h1>{{ person.name }}<span class="verified" hidden title="This author has verified their profile with the Journal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.4.9 3.1 2.8 1.6-1.2 3 1.2 3-2.8 1.6-.9 3.1-3.2-.4L12 22l-2.4-2.1-3.2.4-.9-3.1L2.7 15.6l1.2-3-1.2-3 2.8-1.6.9-3.1 3.2.4z" fill="currentColor"/><path d="M8 12.2l2.6 2.6L16.2 9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr">Verified author</span></span></h1>
      <p class="aff" data-aff{% if not prof.affiliation %} hidden{% endif %}>{{ prof.affiliation }}</p>
      {%- if service %}<p class="ah-role">{{ (service.roles | first) | roleLine }}, {{ site.title }}{% if service.roles.length > 1 %} · {{ service.roles.length }} years of service{% endif %}</p>{% endif %}
    </div>
  </div>
  <p class="bio"{% if not prof.bio %} hidden{% endif %}>{{ prof.bio }}</p>
  <ul class="ah-facts">
    <li><b>{{ person.articles.length }}</b> {{ "publication" if person.articles.length == 1 else "publications" }}</li>
    {%- if first %}<li>since <b>{{ first.data.year }}</b></li>{% endif %}
    <li>{{ "Volume" if vols.length == 1 else "Volumes" }} <b>{{ vols | join(", ") }}</b></li>
  </ul>
  <p class="links ah-links">
    <button type="button" data-copy-link>Copy profile link</button>
    {%- if prof.linkedin %}<a href="{{ prof.linkedin }}" rel="noopener">LinkedIn</a>{% endif %}
    {%- if prof.orcid %}<a href="https://orcid.org/{{ prof.orcid }}" rel="noopener">ORCID</a>{% endif %}
    {%- if prof.facebook %}<a href="{{ prof.facebook }}" rel="noopener">Facebook</a>{% endif %}
  </p>
  <div class="claim-box" id="claim" data-claim hidden></div>
</div></header>

<section class="author-work"><div class="wrap">
  <h2 class="title">Publications</h2>
  {%- set mslugs = [] %}{% for a in person.articles %}{% set _ = mslugs.push(a.page.fileSlug) %}{% endfor %}
  <p class="readership" data-metrics-sum="{{ mslugs | join(',') }}" hidden>Readership on this site{% if person.articles.length > 1 %}, across {{ person.articles.length }} pieces{% endif %}: <b data-m="views"></b> views · <b data-m="reads"></b> full reads · <b data-m="downloads"></b> PDF downloads</p>
  <ol class="biblio">
    {%- for a in person.articles %}
    {%- set pg = (a.data.first_page + ("–" + a.data.last_page if a.data.last_page and a.data.last_page != a.data.first_page else "")) if a.data.first_page else "" %}
    {%- set co = a.data.author | coauthors(person.name) %}
    <li>
      <span class="bib-yr">{{ a.data.year }}</span>
      <div class="bib-body">
        <a class="bib-title" href="{{ a.url }}">{{ a.data.title }}</a>
        {%- if a.data.honors and a.data.honors.length %}<span class="bib-honor">{{ a.data.honors | join(" · ") }}</span>{% endif %}
        <p class="bib-meta"><i>{{ site.short }}</i> Vol. {{ a.data.volume | roman }}{% if pg %}, {{ "p." if pg == (a.data.first_page | string) else "pp." }} {{ pg }}{% endif %} · {{ a.data.kind }} · <a href="/areas/{{ a.data.area | slugify }}/">{{ a.data.area }}</a>{% if co.length %} · with {{ co | join(" and ") }}{% endif %}</p>
        <p class="bib-acts"><a href="{{ a.url }}">Read</a>{% if a.data.pdf %}<a href="{{ a.data.pdf }}">PDF</a>{% endif %}<a href="/verify/{{ a.page.fileSlug }}/">Record of publication</a></p>
        {%- if a.data.abstract %}<details class="bib-abs"><summary>Abstract</summary><p>{{ a.data.abstract }}</p></details>{% endif %}
      </div>
    </li>
    {%- endfor %}
  </ol>
  {%- if service %}
  <h2 class="title ah-service-h">Editorial service</h2>
  <ul class="ah-service">
    {%- for r in service.roles %}<li><b>{{ r | roleLine }}</b><span>Academic Year {{ r.year }}</span></li>{% endfor %}
  </ul>
  <p class="more"><a href="/verify/editor/{{ person.slug }}/">Record of editorial service →</a></p>
  {%- endif %}
</div></section>

{#- for the author themself (verified) and the Board: every piece as a CV line with its public record -#}
<section id="cv" data-author-only="{{ person.slug }}" hidden><div class="wrap">
  <h2 class="title">Your publications, for your CV</h2>
  <p class="sub">Copy-ready lines with the Journal's public record. Only you and the Board see this section.</p>
  <div class="cv-lines" style="max-width:46rem;margin:0 auto">
    {%- for a in person.articles %}
    <div class="cv-line"><span class="cv-lbl">{{ a.data.kind }} · Vol. {{ a.data.volume }}</span><p id="cvp-{{ loop.index }}">{{ { author: a.data.author, title: a.data.title, volume: a.data.volume, first_page: a.data.first_page, year: a.data.year, doi: a.data.doi } | cite(site.short) }}{% if a.data.honors and a.data.honors.length %} {{ a.data.honors | join("; ") }}.{% endif %} Verified: {{ site.url }}/verify/{{ a.page.fileSlug }}/</p><button class="chip" type="button" data-copy="#cvp-{{ loop.index }}" data-copy-msg="Copied">Copy</button></div>
    {%- endfor %}
  </div>
</div></section>

{%- if site.certificates %}
{#- certificates: for the author themself (verified) and the Board -#}
<section class="wash" id="certs" data-author-only="{{ person.slug }}" hidden><div class="wrap">
  <h2 class="title">Your certificates</h2>
  <p class="sub">A certificate of publication for each piece, to print, frame, or share. Only you and the Board see this.</p>
  <div class="certs" style="max-width:52rem;margin:0 auto">
    {%- for a in person.articles %}
    {%- set file = a.page.fileSlug + "--" + person.slug %}
    <figure class="cert" style="text-align:center">
      <a href="/certificates/{{ file }}.pdf"><img src="/certificates/{{ file }}.png" width="2339" height="1654" loading="lazy" alt="Certificate of publication: {{ a.data.title }}"></a>
      <figcaption>Volume {{ a.data.volume }} · {{ a.data.year }}</figcaption>
      <div class="acts"><a class="btn sm" href="/certificates/{{ file }}.pdf" download>Download PDF</a></div>
    </figure>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}
<script type="module" src="/assets/js/author-page.js"></script>
<script type="module" src="/assets/js/metrics.js"></script>

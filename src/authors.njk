---
layout: layouts/base.njk
title: Authors
permalink: /authors/
description: Every author published in the Journal for Law Advocacy.
searchExclude: true
---
<header class="pagehead"><div class="wrap">
  <h1>Authors</h1>
  <p>{{ collections.authors.length }} authors published in the journal, by family name.</p>
</div></header>

<section><div class="wrap">
  <ul class="authors">
    {%- for p in collections.authors %}
    {%- set latest = p.articles | first %}
    <li style="--i:{{ loop.index0 }}"><a href="/authors/{{ p.slug }}/">
      <span class="nm"><span class="hl">{{ p.name }}</span></span>
      <span class="ct" aria-label="{{ p.articles.length }} {{ 'publication' if p.articles.length == 1 else 'publications' }}">{{ p.articles.length }}</span>
      {%- if latest %}<span class="peek">{{ latest.data.title }}<em>Vol. {{ latest.data.volume }} · {{ latest.data.year }}</em></span>{% endif %}
    </a></li>
    {%- endfor %}
  </ul>
</div></section>

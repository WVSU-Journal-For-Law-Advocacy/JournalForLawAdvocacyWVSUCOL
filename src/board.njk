---
layout: layouts/base.njk
pagination:
  data: board.boards
  size: 1
  alias: b
permalink: "{% if pagination.pageNumber == 0 %}/board/{% else %}/board/{{ b.academic_year | slugify }}/{% endif %}"
eleventyComputed:
  title: "{% if pagination.pageNumber == 0 %}Editorial board{% else %}Editorial board {{ b.academic_year }}{% endif %}"
description: The Board of Editors, Contribution Editors, and Editorial Apprentices of the WVSU Journal for Law Advocacy.
---
<header class="pagehead"><div class="wrap">
  {%- if pagination.pageNumber > 0 %}<p class="crumb"><a href="/board/">Editorial board</a></p>{% endif %}
  <h1>Editorial board</h1>
  <p>Academic Year {{ b.academic_year }}{% if b.label %} · {{ b.label }}{% endif %}{% if pagination.pageNumber == 0 %} · Current board{% endif %}</p>
</div></header>

<section><div class="wrap">
  {%- if b.note %}<p class="notice board-note">{{ b.note }}</p>{% endif %}
  {%- for g in b.groups %}
  {%- set people = b.members | where("group", g) %}
  {%- if people.length %}
  <h2 class="title board-group">{{ g }}</h2>
  <div class="board">
    {%- for m in people %}
    <div class="member">
      {%- if m.photo %}<img src="{{ m.photo }}" alt="" width="160" height="160" loading="lazy">{% endif %}
      <h3>{{ m.name }}</h3>
      <p class="role">{{ m.role }}</p>
      {%- if m.detail %}<p>{{ m.detail }}</p>{% endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- endfor %}

  {%- if board.boards.length > 1 %}
  <h2 class="title board-group" style="margin-top:3.5rem">Past boards</h2>
  <ul class="vols">
    {%- for past in board.boards %}
    {%- if loop.index0 > 0 %}
    <li><b><a href="/board/{{ past.academic_year | slugify }}/">Academic Year {{ past.academic_year }}</a></b><span class="dots"></span><span class="st">{{ past.members.length }} members</span></li>
    {%- endif %}
    {%- endfor %}
  </ul>
  {%- endif %}
</div></section>

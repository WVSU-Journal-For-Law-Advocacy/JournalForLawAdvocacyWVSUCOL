---
layout: layouts/base.njk
title: Editorial board
permalink: /board/
description: The Board of Editors, Contribution Editors, and Editorial Apprentices of the Journal for Law Advocacy.
---
<header class="pagehead"><div class="wrap">
  <h1>Editorial board</h1>
  <p>Academic Year {{ board.academic_year }}</p>
</div></header>

<section><div class="wrap">
  {%- for g in board.groups %}
  {%- set people = board.members | where("group", g) %}
  {%- if people.length %}
  <h2 class="title board-group">{{ g }}</h2>
  <div class="board">
    {%- for m in people %}
    <div class="member">
      {%- if m.photo %}<img src="{{ m.photo }}" alt="" width="160" height="160" loading="lazy">{% endif %}
      <h3>{{ m.name }}</h3>
      <p class="role">{{ m.role }}</p>
      {%- if m.detail %}<p>{{ m.detail }}</p>{% endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- endfor %}
</div></section>

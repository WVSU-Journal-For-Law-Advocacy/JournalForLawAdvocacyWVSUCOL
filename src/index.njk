---
layout: layouts/base.njk
---
{%- set cur = collections.issues | currentIssue %}
{%- set contents = (collections.articles | inIssue(cur.data.volume, cur.data.issue)) if cur else [] %}
<header class="hero" id="top"><div class="wrap">
  <div>
    <img class="seal" src="/assets/img/seal-240.png" width="104" height="104" alt="Seal of the Journal for Law Advocacy, WVSU College of Law, 2021">
    <h1>{{ site.title }}</h1>
    <p class="inst">{{ site.tagline }}</p>
    <p class="lead">{{ site.description }}</p>
    <div class="btns">
      {%- if cur %}<a class="btn" href="{{ cur.url }}">Read the current issue</a>{% endif %}
      <a class="btn alt" href="/submit/">Submit your work</a>
    </div>
  </div>
  {%- if cur %}
  <aside class="toc" aria-label="Current issue contents">
    <h2>{{ cur.data.title }}</h2>
    <p class="meta">Academic Year {{ cur.data.academic_year }} · Table of contents</p>
    <ol>
      {%- for a in contents %}
      <li style="--n:{{ loop.index0 }}"><a href="{{ a.url }}"><span class="tt">{{ a.data.title }}<small>{{ a.data.author }} · {{ a.data.kind }}</small></span><span class="dots"></span><span class="pg">{{ a.data.first_page }}</span></a></li>
      {%- endfor %}
    </ol>
  </aside>
  {%- endif %}
</div></header>

<section><div class="wrap">
  <h2 class="title">Latest articles</h2>
  <p class="sub">Recent scholarship from the journal. Browse every article by area of law on the <a href="/articles/">articles page</a>.</p>
  {%- for a in collections.articles.slice(0, 4) %}
  {%- include "entry.njk" %}
  {%- endfor %}
  <p class="more"><a href="/articles/">All articles →</a></p>
</div></section>

<section class="wash"><div class="wrap cols">
  <div>
    <h2 class="title">About the journal</h2>
    <p>{{ site.title }} is the official publication of the {{ site.institution }}. It publishes original legal scholarship from students, faculty, and practitioners.</p>
    <p class="more"><a href="/about/">Read more about the journal →</a></p>
  </div>
  <div>
    <h2 class="title">Write for us</h2>
    <p>We accept articles, case comments, and student notes year-round.</p>
    <p class="more"><a href="/submit/">Submission guidelines →</a></p>
  </div>
</div></section>

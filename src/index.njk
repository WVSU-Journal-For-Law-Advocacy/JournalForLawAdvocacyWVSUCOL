---
searchExclude: true
layout: layouts/base.njk
---
{%- set cur = collections.issues | currentIssue %}
{%- set contents = (collections.articles | inIssue(cur.data.volume, cur.data.issue)) if cur else [] %}
{%- set featured = contents | featuredOf %}
{#- ===== The app's Home (shown only in the installed app; the website keeps the page below) ===== -#}
<div class="app-home" data-tones="{{ site.area_tones | dump }}">
  <header class="ah-brand">
    <img src="/assets/img/seal-240.png" alt="" width="76" height="76">
    <div>
      <p class="ahb-pre">WVSU</p>
      <p class="ahb-name">Journal for Law Advocacy</p>
      <p class="ahb-est">Est. MMXXI · {{ site.city | replace(", Philippines", "") }}</p>
    </div>
  </header>
  <div class="ah-hello">
    <p class="ah-date" data-today></p>
    <h1 data-hello>Welcome</h1>
    <a class="ah-streak" href="/account/" data-streak hidden></a>
  </div>

  {%- if cur %}
  {#- featured: the current volume, then its lead pieces, as wide banners with their photo as a faded backdrop -#}
  {%- set feat = [] %}{% set lead = contents | featuredOf %}{% if lead %}{% set _ = feat.push(lead) %}{% endif %}
  {%- for a in contents %}{% if feat.length < 4 and a.url != lead.url %}{% set _ = feat.push(a) %}{% endif %}{% endfor %}
  <section class="feature-rail" aria-roledescription="carousel" aria-label="Featured" data-rail>
    <div class="fr-track" data-rail-track>
      {%- set vp = ("volume-" + cur.data.volume) | coverFor(collections.coverPhotos) %}
      <a class="fr-slide" href="{{ cur.url }}" style="--tone:{{ site.volume_tones[cur.data.volume | string] or '#4A2466' }}{% if vp %};--aura:url('{{ vp | coverHero(1000) }}'){% endif %}">
        <span class="fr-text">
          <span class="fr-eyebrow">The current volume</span>
          <span class="fr-title">{{ cur.data.title }}</span>
          {%- if cur.data.theme %}<span class="fr-sub">{{ cur.data.theme }}</span>{% endif %}
          <span class="fr-meta">{{ contents.length }} pieces · AY {{ cur.data.academic_year }}</span>
          <span class="fr-cta">Open the volume</span>
        </span>
        <span class="fr-book">{% set v = cur %}{% include "vol-cover.njk" %}</span>
      </a>
      {%- for a in feat %}
      {%- set fp = a.page.fileSlug | coverFor(collections.coverPhotos) %}
      <a class="fr-slide" href="{{ a.url }}" style="--tone:{{ site.area_tones[a.data.area] or '#4A2466' }}{% if fp %};--aura:url('{{ fp | coverHero(1000) }}'){% endif %}">
        <span class="fr-text">
          <span class="fr-eyebrow">{{ "Lead piece" if loop.first and a.data.featured else a.data.area }}</span>
          <span class="fr-title">{{ a.data.title | coverTitle }}</span>
          <span class="fr-sub">{{ a.data.author }}</span>
          <span class="fr-meta">{{ a.data.kind }} · Vol. {{ a.data.volume | roman }}</span>
          <span class="fr-cta">Read</span>
        </span>
        <span class="fr-book">{% set bare = true %}{% include "cover.njk" %}{% set bare = false %}</span>
      </a>
      {%- endfor %}
    </div>
    <p class="fr-dots" data-rail-dots aria-hidden="true"></p>
  </section>


  <section class="ah-sec" data-continue hidden>
    <h2 class="ah-h">Continue reading</h2>
    <div data-continue-card></div>
  </section>

  {#- most read: a ranking, shown once there are real figures -#}
  {%- set ranked = [] %}{% for a in collections.articles %}{% set _ = ranked.push({ slug: a.page.fileSlug, title: a.data.title, url: a.url, author: a.data.author, area: a.data.area, volume: a.data.volume }) %}{% endfor %}
  <section class="ah-sec ah-rank" data-rank="{{ ranked | dump }}" hidden>
    <div class="ah-row"><h2 class="ah-h">Most read</h2><span class="ah-note">full reads on this site</span></div>
    <ol class="rank-list" data-rank-list></ol>
  </section>

  <section class="ah-sec">
    <div class="ah-row"><h2 class="ah-h">In {{ cur.data.title }}</h2><a href="{{ cur.url }}">See all</a></div>
    <div class="shelf">
      {%- for a in contents %}{% include "cover.njk" %}{% endfor %}
    </div>
  </section>
  {%- endif %}

  <section class="ah-sec" data-foryou hidden>
    <div class="ah-row"><h2 class="ah-h">Picked for you</h2><a href="/articles/">Explore</a></div>
    <div class="shelf" data-foryou-shelf></div>
  </section>

  <section class="ah-sec">
    <h2 class="ah-h">Browse by area</h2>
    <div class="area-grid">
      {%- for ar in site.areas %}
      <a class="area-tile" href="/areas/{{ ar | slugify }}/" style="--tone:{{ site.area_tones[ar] or '#4A2466' }}"><span>{{ ar }}</span></a>
      {%- endfor %}
    </div>
  </section>

  <section class="ah-sec">
    <div class="ah-row"><h2 class="ah-h">The archive</h2><a href="/archive/">All volumes</a></div>
    <div class="shelf vol-shelf">
      {%- for v in collections.issues %}
      {%- set n = (collections.articles | inIssue(v.data.volume, v.data.issue)).length %}
      <a class="book-item shelf-book" href="{{ v.url }}">{%- include "vol-cover.njk" %}<span class="bi-title">{{ v.data.title }}</span><span class="bi-meta">AY {{ v.data.academic_year }} · {{ n }} pieces</span></a>
      {%- endfor %}
    </div>
  </section>

  {%- if collections.news.length %}
  <section class="ah-sec">
    <div class="ah-row"><h2 class="ah-h">News</h2><a href="/news/">All news</a></div>
    <ul class="ah-news">
      {%- for n in collections.news.slice(0, 3) %}
      <li><a href="{{ n.url }}"><time datetime="{{ n.date | isoDate }}">{{ (n.date | monthYear) if n.data.date_approx else (n.date | readableDate) }}</time><b>{{ n.data.title }}</b></a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <a class="write-card" href="/call-for-papers/">
    <span class="eyebrow">From reader to author</span>
    <b>Your argument could open the next volume.</b>
    <span>See the call for papers</span>
  </a>
</div>

<div class="web-home">
<header class="masthead"><div class="wrap">
  <img class="seal" src="/assets/img/seal-240.png" width="120" height="120" alt="Seal of the WVSU Journal for Law Advocacy, WVSU College of Law, 2021">
  <h1>{{ site.title }}</h1>
  <p class="est">Est. MMXXI · {{ site.city }}</p>
  <p class="inst">{{ site.tagline }}</p>
  <div class="btns">
    {%- if cur %}<a class="btn" href="{{ cur.url }}">Read {{ cur.data.title }}</a>{% endif %}
    <a class="btn alt" href="/submit/">Submit your work</a>
  </div>
</div></header>

{%- if cur %}
<section aria-labelledby="current-h"><div class="wrap">
  <h2 class="title" id="current-h">The current volume</h2>
  <p class="sub">{{ cur.data.title }}{% if cur.data.theme %}: {{ cur.data.theme }}{% endif %} · Academic Year {{ cur.data.academic_year }}</p>

  {%- if featured %}
  <article class="feature">
    <span class="eyebrow"><a href="/areas/{{ featured.data.area | slugify }}/">{{ featured.data.area }}</a> · {{ featured.data.kind }}</span>
    <h2><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
    <p class="by">{% for au in featured.data.author | authorLinks %}{% if not loop.first %}{{ " and " if loop.last else ", " }}{% endif %}{% if au.slug %}<a href="/authors/{{ au.slug }}/">{{ au.name }}</a>{% else %}{{ au.name }}{% endif %}{% endfor %}</p>
    <p class="abs">{{ featured.data.abstract }}</p>
    <div class="btns"><a class="btn sm" href="{{ featured.url }}">Read the {{ featured.data.kind | lower }}</a></div>
  </article>
  <div class="orn" aria-hidden="true"><span>❦</span></div>
  {%- endif %}

  <div class="toc">
    <p class="meta">Contents</p>
    <ol>
      {%- for a in contents.slice(0, 10) %}
      <li><a href="{{ a.url }}"><span class="tt">{{ a.data.title }}<small>{{ a.data.author }}</small></span><span class="dots"></span><span class="pg">{{ a.data.first_page }}</span></a></li>
      {%- endfor %}
    </ol>
  </div>
  {%- if contents.length > 10 %}<p class="more"><a href="{{ cur.url }}#contents">All {{ contents.length }} pieces in {{ cur.data.title }} →</a></p>{% endif %}
</div></section>
{%- endif %}

{%- if collections.news.length %}
<section class="wash" aria-labelledby="news-h"><div class="wrap">
  <h2 class="title" id="news-h">News</h2>
  <div class="news-list news-row">
    {%- for n in collections.news.slice(0, 3) %}
    {%- include "news-item.njk" %}
    {%- endfor %}
  </div>
  <p class="more"><a href="/news/">All news →</a></p>
</div></section>
{%- endif %}

<section aria-labelledby="archive-h"><div class="wrap">
  <h2 class="title" id="archive-h">The archive</h2>
  <p class="sub">Every volume since the inaugural issue of MMXXI, each article with its own page, PDF, and citation.</p>
  {%- include "plates.njk" %}
  <p class="more"><a href="/articles/">Browse all articles →</a></p>
</div></section>

<section class="wash" aria-labelledby="write-h"><div class="wrap home-intro">
  <h2 class="title" id="write-h">Write for the journal</h2>
  <p>{{ site.title }} is a student publication of the {{ site.institution }}. We accept articles, essays, case comments, and student notes year-round.</p>
  <div class="btns"><a class="btn" href="/submit/">Submit your work</a><a class="btn alt" href="/about/">About the journal</a></div>
</div></section>
</div>

---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{%- set latest = collections.issues | currentIssue -%}
{{ {
  "id": "/",
  "name": site.title,
  "short_name": "WVSU JLA",
  "description": site.description,
  "lang": "en-PH",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#4A2466",
  "background_color": "#2B1438",
  "categories": ["education", "books", "news"],
  "handle_links": "preferred",
  "icons": [
    { "src": "/assets/img/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My library", "url": "/account/?source=app", "icons": [{ "src": "/assets/img/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Latest volume", "url": (latest.url if latest else "/archive/") + "?source=app", "icons": [{ "src": "/assets/img/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/search/?source=app", "icons": [{ "src": "/assets/img/app/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": { "action": "/search/", "method": "GET", "params": { "title": "title", "text": "q", "url": "url" } }
} | dump(2) | safe }}

---
layout: layouts/base.njk
title: Search
permalink: /search/
description: Search every article, policy, and announcement of the WVSU Journal for Law Advocacy.
searchExclude: true
---
<header class="pagehead"><div class="wrap">
  <h1>Search</h1>
  <p>Search titles, authors, abstracts, policies, and news. Filter results by area of law, volume, or author.</p>
</div></header>

<section><div class="wrap">
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <div id="search"></div>
  <div class="search-start" data-search-start>
    <h2 class="ss-h">Try</h2>
    <p class="ss-chips">
      {%- for t in ["Data Privacy Act", "artificial intelligence", "freedom of expression", "cybercrime", "COMELEC", "Writ of Kalikasan", "mangroves", "legal ethics"] %}<button type="button" data-q="{{ t }}">{{ t }}</button>{% endfor %}
    </p>
    <h2 class="ss-h">Or browse an area of law</h2>
    <div class="area-grid">
      {%- for ar in site.areas %}<a class="area-tile" href="/areas/{{ ar | slugify }}/" style="--tone:{{ site.area_tones[ar] or '#4A2466' }}"><span>{{ ar }}</span></a>{% endfor %}
    </div>
  </div>
  <noscript><p class="empty">Search needs JavaScript. You can also browse the <a href="/articles/">articles list</a> or the <a href="/archive/">archive</a>.</p></noscript>
  <script src="/pagefind/pagefind-ui.js"></script>
  <script>
    // shared into the installed app: a link to this journal opens that page; any other text is searched
    (() => {
      const p = new URLSearchParams(location.search);
      const shared = [p.get('url'), p.get('q'), p.get('title')].filter(Boolean).join(' ');
      const m = shared.match(/https?:\/\/{{ site.url | replace("https://", "") | replace(".", "\\.") }}(\/[^\s]*)/);
      if (m) return location.replace(m[1]);
      if (!p.get('q') && (p.get('title') || p.get('url'))) { p.set('q', p.get('title') || p.get('url')); history.replaceState(null, '', '?' + p.toString()); }
    })();
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) {
        document.getElementById('search').innerHTML = '<p class="empty">Search is built when the site is deployed, so it isn\'t available in local preview.</p>';
        return;
      }
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false,
        translations: { placeholder: 'Search the journal' } });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
      // the suggestions step aside once there is a search
      const start = document.querySelector('[data-search-start]');
      const sync = () => { const i = document.querySelector('#search input'); start.hidden = !!(i && i.value.trim()); };
      start.addEventListener('click', (e) => { const b = e.target.closest('[data-q]'); if (!b) return; ui.triggerSearch(b.dataset.q); const i = document.querySelector('#search input'); if (i) i.value = b.dataset.q; sync(); scrollTo(0, 0); });
      document.getElementById('search').addEventListener('input', sync); sync();
    });
  </script>
</div></section>
